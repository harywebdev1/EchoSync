{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 60000,
      "catalog": 30000,
      "execution": 600000
    },
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp@latest"],
        "disabled": false
      },
      "context7": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@upstash/context7-mcp@latest"],
        "disabled": false
      },
      "sequential-thinking": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
        "disabled": false
      }
    }
  }
}
