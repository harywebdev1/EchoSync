{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/media.js": {
      "maxDuration": 30
    },
    "api/youtube-audio.js": {
      "maxDuration": 30
    },
    "api/ytmusic.js": {
      "maxDuration": 20
    },
    "api/saavn.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/api/ytmusic/:route*",
      "destination": "/api/ytmusic?route=:route*"
    },
    {
      "source": "/api/saavn/:route*",
      "destination": "/api/saavn?route=:route*"
    },
    {
      "source": "/api/youtube/audio/:videoId",
      "destination": "/api/youtube-audio?videoId=:videoId"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
